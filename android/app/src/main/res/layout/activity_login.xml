<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/commercial_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- ── Brand Hero Header ────────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_commercial_avatar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🚌"
            android:textSize="32sp" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.04"
        android:text="GITAM DRIVER PORTAL"
        android:textColor="@color/commercial_charcoal"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif-medium"
        android:text="Campus Fleet Transit System • v3.0"
        android:textColor="@color/commercial_emerald_dark"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Secure Driver &amp; Vehicle Dispatch Gateway"
        android:textColor="@color/commercial_charcoal_muted"
        android:textSize="11sp" />

    <!-- ── Crisp White Commercial Login Card ────────────────────────────── -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/commercial_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="DRIVER SIGN IN"
                android:textColor="@color/commercial_charcoal"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Enter driver employee ID and security PIN"
                android:textColor="@color/commercial_charcoal_muted"
                android:textSize="12sp" />

            <!-- Employee ID Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-bold"
                android:text="EMPLOYEE BADGE ID"
                android:textColor="@color/commercial_charcoal"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/etEmployeeId"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_commercial_input"
                android:drawableStart="@android:drawable/ic_menu_myplaces"
                android:drawablePadding="10dp"
                android:drawableTint="@color/commercial_charcoal_light"
                android:fontFamily="monospace"
                android:hint="e.g. DRV-8821"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="12dp"
                android:textColor="@color/commercial_charcoal"
                android:textColorHint="@color/commercial_charcoal_light"
                android:textSize="13sp" />

            <!-- PIN Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-bold"
                android:text="SECURITY PIN"
                android:textColor="@color/commercial_charcoal"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_commercial_input"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawablePadding="10dp"
                android:drawableTint="@color/commercial_charcoal_light"
                android:fontFamily="monospace"
                android:hint="4-Digit PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:paddingHorizontal="12dp"
                android:textColor="@color/commercial_charcoal"
                android:textColorHint="@color/commercial_charcoal_light"
                android:textSize="14sp" />

            <!-- Status / Loading Label -->
            <TextView
                android:id="@+id/tvLoginStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/commercial_emerald_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBarLogin"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:indeterminateTint="@color/commercial_emerald"
                android:visibility="gone" />

            <!-- Primary Login Button (Large Commercial Emerald) -->
            <Button
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_commercial_btn_go"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="SIGN IN &amp; SYNC FLEET"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:backgroundTint="@null" />

            <!-- Quick 1-Tap Demo Credentials Pill -->
            <TextView
                android:id="@+id/btnQuickDemoDriver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_commercial_input"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="👤 Quick Fill: Captain Ramesh (DRV-8821)"
                android:textColor="@color/commercial_charcoal"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Cloud Ingestion Target Indicator -->
    <TextView
        android:id="@+id/tvCloudTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="☁️ Connected to: fleet-command-api.onrender.com"
        android:textColor="@color/commercial_charcoal_light"
        android:textSize="11sp" />

</LinearLayout>
