<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/charcoal_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- ── Brand Hero Header ────────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_gradient_indigo_purple">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="⚡"
            android:textColor="@color/white"
            android:textSize="32sp" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.06"
        android:text="FLEET COMMAND"
        android:textColor="@color/white"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:text="Driver Authentication Portal • v3.0"
        android:textColor="@color/indigo_accent"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="GITAM University Campus Transit Emitter"
        android:textColor="@color/slate_500"
        android:textSize="11sp" />

    <!-- ── Neo-Morphic Login Card ───────────────────────────────────────── -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/charcoal_card"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neomorphic_card"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="CAPTAIN SIGN IN"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Enter designated transit badge credentials"
                android:textColor="@color/slate_400"
                android:textSize="11sp" />

            <!-- Employee ID Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="EMPLOYEE BADGE ID"
                android:textColor="@color/amber_electric"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmployeeId"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@android:drawable/ic_menu_myplaces"
                android:drawablePadding="10dp"
                android:drawableTint="@color/slate_400"
                android:fontFamily="monospace"
                android:hint="e.g. DRV-8821"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/slate_600"
                android:textSize="13sp" />

            <!-- PIN Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="SECURITY PIN"
                android:textColor="@color/amber_electric"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPin"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawablePadding="10dp"
                android:drawableTint="@color/slate_400"
                android:fontFamily="monospace"
                android:hint="4-Digit PIN"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/slate_600"
                android:textSize="14sp" />

            <!-- Status / Loading Label -->
            <TextView
                android:id="@+id/tvLoginStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/cyan_neon"
                android:textSize="11sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBarLogin"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:indeterminateTint="@color/purple_primary"
                android:visibility="gone" />

            <!-- Primary Login Button -->
            <Button
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_gradient_indigo_purple"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="AUTHENTICATE &amp; SYNC ASSETS"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="@null" />

            <!-- Quick 1-Tap Demo Credentials Pill -->
            <TextView
                android:id="@+id/btnQuickDemoDriver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="monospace"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="⚡ 1-Tap Demo: Captain Ramesh (DRV-8821)"
                android:textColor="@color/indigo_accent"
                android:textSize="10sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Cloud Ingestion Target Indicator -->
    <TextView
        android:id="@+id/tvCloudTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="monospace"
        android:text="☁️ Cloud Ingestion: fleet-command-api.onrender.com"
        android:textColor="@color/slate_600"
        android:textSize="10sp" />

</LinearLayout>
