<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/commercial_bg"
    android:orientation="vertical">

    <!-- ── Commercial Driver Portal Top Header (Uber Driver Inspired) ────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/commercial_surface"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <!-- Driver Profile Avatar Placeholder -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_commercial_avatar">

            <TextView
                android:id="@+id/tvDriverAvatarInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="RK"
                android:textColor="@color/commercial_charcoal"
                android:textSize="16sp" />
        </FrameLayout>

        <!-- Driver Information & Portal Branding -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:text="GITAM Driver Portal"
                    android:textColor="@color/commercial_charcoal"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_commercial_badge_emerald"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="v3.0"
                    android:textColor="@color/commercial_emerald_dark"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDriverProfileBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Captain Ramesh Kumar • 4.9 ★"
                android:textColor="@color/commercial_charcoal_muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Driver Sign Out Button -->
        <TextView
            android:id="@+id/btnSignOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Sign Out"
            android:textColor="@color/commercial_charcoal_muted"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Duty Status Top Banner ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutDutyBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E5E7EB"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp">

        <View
            android:id="@+id/viewDutyDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_commercial_avatar" />

        <TextView
            android:id="@+id/tvLiveStatusBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="OFFLINE • NOT READY"
            android:textColor="@color/commercial_charcoal"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvOperationalState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_commercial_card"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="STANDBY"
            android:textColor="@color/commercial_charcoal_muted"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── Main Scrollable Driver Operations Area ────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Card 1: Assigned Vehicle & QR Binding (Crisp White Card) ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/commercial_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:text="ASSIGNED VEHICLE"
                            android:textColor="@color/commercial_charcoal"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvBoundStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_commercial_input"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="UNPAIRED"
                            android:textColor="@color/commercial_charcoal_light"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Verified Vehicle Display Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_commercial_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvVehicleIcon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚌"
                            android:textSize="26sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vehicle Asset Tag"
                                android:textColor="@color/commercial_charcoal_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBoundAssetTag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="[ SCAN QR CODE TO PAIR ]"
                                android:textColor="@color/commercial_charcoal"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Verified Checkmark / Unbind Button -->
                        <TextView
                            android:id="@+id/btnClearVehicleTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="6dp"
                            android:text="✕ Change"
                            android:textColor="@color/commercial_red"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Frictionless QR Scan Action Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/btnScanQr"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_commercial_btn_go"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📷 "
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.04"
                                android:text="SCAN BUS QR CODE"
                                android:textColor="@color/white"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Cloud Fleet Fallback Picker -->
                        <TextView
                            android:id="@+id/btnDynamicBusPicker"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_commercial_input"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="☁️ Roster"
                            android:textColor="@color/commercial_charcoal"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Ingestion Endpoint Toggle (Collapsible/Subtle) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cloud Sync Target:"
                            android:textColor="@color/commercial_charcoal_light"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnSetCloudUrl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_commercial_badge_emerald"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Render Cloud"
                            android:textColor="@color/commercial_emerald_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSetLocalUrl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_commercial_input"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="Local LAN"
                            android:textColor="@color/commercial_charcoal_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_commercial_input"
                        android:fontFamily="monospace"
                        android:inputType="textUri"
                        android:paddingHorizontal="10dp"
                        android:textColor="@color/commercial_charcoal"
                        android:textColorHint="@color/commercial_charcoal_light"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Card 2: Real-World Commercial Transit Telemetry & Speed ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/commercial_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05"
                        android:text="CURRENT GROUND SPEED"
                        android:textColor="@color/commercial_charcoal_light"
                        android:textSize="11sp" />

                    <!-- Speed Typography (Large Charcoal Text) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLiveSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="0.0"
                            android:textColor="@color/commercial_charcoal"
                            android:textSize="64sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="km/h"
                            android:textColor="@color/commercial_charcoal_muted"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- Kinetic Deadband Filter Status -->
                    <TextView
                        android:id="@+id/tvSpeedFilterLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_commercial_input"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Rest Speed Drift Filter Active (&lt; 3.6 km/h = 0.0)"
                        android:textColor="@color/commercial_charcoal_muted"
                        android:textSize="10sp" />

                    <!-- 15-Minute Campus Boarding Banner -->
                    <TextView
                        android:id="@+id/tvBoardingTimerHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_commercial_badge_amber"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="🚍 At Campus (Boarding) • Idle timeouts suppressed for 15+ mins"
                        android:textColor="@color/commercial_amber"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- DFSM Operational Mode Controls -->
                    <LinearLayout
                        android:id="@+id/layoutDfsmActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <!-- At Campus (Boarding) Button -->
                        <TextView
                            android:id="@+id/btnStartBoarding"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_commercial_badge_amber"
                            android:gravity="center"
                            android:text="🚍 At Campus (Boarding)"
                            android:textColor="@color/commercial_amber"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Outbound Transit Button -->
                        <TextView
                            android:id="@+id/btnResumeTransit"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_commercial_badge_emerald"
                            android:gravity="center"
                            android:text="▶️ In Transit"
                            android:textColor="@color/commercial_emerald_dark"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Layover Mode Button -->
                        <TextView
                            android:id="@+id/btnToggleLayover"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_commercial_input"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="⏸️ Pause"
                            android:textColor="@color/commercial_charcoal_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/commercial_border" />

                    <!-- Coordinates and Accuracy -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GPS / FUSED POSITION"
                                android:textColor="@color/commercial_charcoal_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCoordinates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="17.782167, 83.377472"
                                android:textColor="@color/commercial_charcoal"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACCURACY"
                                android:textColor="@color/commercial_charcoal_light"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAccuracy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="± 1.2 m"
                                android:textColor="@color/commercial_emerald_dark"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Card 3: Network & Security Status (Crisp White Card) ────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/commercial_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ Anti-Spoof Security:"
                            android:textColor="@color/commercial_charcoal_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAntiSpoofStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Hardware Verified (0 Mock)"
                            android:textColor="@color/commercial_emerald_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📶 Network Connection:"
                            android:textColor="@color/commercial_charcoal_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNetworkStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Online (WiFi / 4G)"
                            android:textColor="@color/commercial_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📦 SQLite Offline Queue:"
                            android:textColor="@color/commercial_charcoal_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOfflineQueue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="0 pending records"
                            android:textColor="@color/commercial_charcoal_light"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Battery Optimization Exemption Pill -->
            <TextView
                android:id="@+id/btnBatteryOpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_commercial_input"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="🔋 Check Background Battery Exemption"
                android:textColor="@color/commercial_charcoal_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <!-- ── Uber Driver Inspired Large Thumb-Friendly Shift Control ──────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/commercial_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <!-- Large "GO / START DUTY" Button (Emerald Green) -->
        <FrameLayout
            android:id="@+id/btnShiftToggleAction"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_commercial_btn_go">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvShiftActionIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ "
                    android:textColor="@color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvShiftActionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.06"
                    android:text="GO / START DUTY"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
