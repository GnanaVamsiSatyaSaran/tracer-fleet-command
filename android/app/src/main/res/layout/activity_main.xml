<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/charcoal_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ── Top Enterprise Header Bar ──────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_gradient_indigo_purple">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚡"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="FLEET TRACKER"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_gradient_indigo_purple"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="v3.0"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDriverProfileBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Captain: Ramesh Kumar (DRV-8821)"
                android:textColor="@color/indigo_accent"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Driver Sign Out Button -->
        <TextView
            android:id="@+id/btnSignOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="monospace"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Sign Out"
            android:textColor="@color/slate_400"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvLiveStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="STANDBY"
            android:textColor="@color/slate_400"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Card 1: Physical Identity Decoupling (QR Scanner) ─────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/charcoal_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_neomorphic_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="PHYSICAL IDENTITY DECOUPLING"
                            android:textColor="@color/indigo_accent"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBoundStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="NOT PAIRED"
                            android:textColor="@color/slate_400"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Bound Vehicle Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚍"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VEHICLE TRANSPONDER TAG"
                                android:textColor="@color/slate_500"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBoundAssetTag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="[ SCAN QR TO BIND ]"
                                android:textColor="@color/amber_electric"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnClearVehicleTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:padding="6dp"
                            android:text="✕ Unbind"
                            android:textColor="@color/crimson_stop"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- QR Scanner Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Main QR Scan Button (Google ML Kit Vision) -->
                        <LinearLayout
                            android:id="@+id/btnScanQr"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_gradient_indigo_purple"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📷 "
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.05"
                                android:text="SCAN VEHICLE QR"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Dynamic Cloud Fleet Selector -->
                        <TextView
                            android:id="@+id/btnDynamicBusPicker"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="☁️ Cloud Fleet"
                            android:textColor="@color/cyan_neon"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Ingestion Endpoint Settings -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="INGESTION TARGET"
                            android:textColor="@color/slate_400"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSetCloudUrl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="☁️ Render Cloud"
                            android:textColor="@color/cyan_neon"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnSetLocalUrl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="monospace"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="💻 Local LAN"
                            android:textColor="@color/slate_400"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="monospace"
                        android:inputType="textUri"
                        android:paddingHorizontal="10dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/slate_500"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Card 2: 4-State DFSM HUD & Kinetic Deadband Readout ─────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/charcoal_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_neomorphic_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- DFSM Operational State Indicator Banner -->
                    <TextView
                        android:id="@+id/tvOperationalState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.08"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="AWAITING VEHICLE ASSIGNMENT"
                        android:textColor="@color/status_standby"
                        android:textSize="11sp" />

                    <!-- 15-Minute Boarding Mode Dynamic Hint & Timer -->
                    <TextView
                        android:id="@+id/tvBoardingTimerHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text="Boarding active: Idle timeouts suppressed for 15+ mins"
                        android:textColor="@color/status_boarding"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <!-- Concentric Radar Pulse Ring Frame -->
                    <FrameLayout
                        android:layout_width="106dp"
                        android:layout_height="106dp"
                        android:layout_marginTop="10dp">

                        <com.tracer.fleettracker.ui.RadarPulseView
                            android:id="@+id/radarPulseView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🚌"
                            android:textSize="22sp" />
                    </FrameLayout>

                    <!-- Current Ground Speed Readout (with Kinetic Deadband Filter) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLiveSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="0.0"
                            android:textColor="@color/amber_electric"
                            android:textSize="56sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="km/h"
                            android:textColor="@color/slate_400"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSpeedFilterLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Kinetic Deadband Filter Active (Speed &lt; 3.6 km/h = 0.0)"
                        android:textColor="@color/slate_500"
                        android:textSize="9sp" />

                    <!-- DFSM Operational State Transition Buttons -->
                    <LinearLayout
                        android:id="@+id/layoutDfsmActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <!-- 15-Minute Boarding Mode Button -->
                        <TextView
                            android:id="@+id/btnStartBoarding"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="🚍 Start Boarding"
                            android:textColor="@color/status_boarding"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <!-- Campus Layover Privacy Button -->
                        <TextView
                            android:id="@+id/btnToggleLayover"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="⏸️ Layover Mode"
                            android:textColor="@color/cyan_neon"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <!-- Resume Outbound Transit Button -->
                        <TextView
                            android:id="@+id/btnResumeTransit"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="▶️ Transit"
                            android:textColor="@color/emerald_online"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/charcoal_border" />

                    <!-- Coordinates and Fused Accuracy -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FUSED GNSS / CELLULAR"
                                android:textColor="@color/slate_500"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvCoordinates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="17.782167, 83.377472"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACCURACY"
                                android:textColor="@color/slate_500"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAccuracy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:text="± 1.2 m"
                                android:textColor="@color/emerald_online"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Card 3: Network & Anti-Spoofing Hardware Security ──────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/charcoal_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_neomorphic_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ Anti-Spoof Hardware:"
                            android:textColor="@color/slate_400"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvAntiSpoofStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="GNSS Verified (0 Spoofed)"
                            android:textColor="@color/emerald_online"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📶 Network Transmission:"
                            android:textColor="@color/slate_400"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvNetworkStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="Connected (WiFi / 4G)"
                            android:textColor="@color/cyan_neon"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📦 SQLite Backlog Queue:"
                            android:textColor="@color/slate_400"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvOfflineQueue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="0 pending records"
                            android:textColor="@color/amber_electric"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Battery Optimization Exemption Pill ────────────────────── -->
            <TextView
                android:id="@+id/btnBatteryOpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="🔋 Check Doze &amp; Battery Exemption"
                android:textColor="@color/slate_400"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <!-- ── Interactive Swipe-to-Start Shift Component ─────────────────────── -->
    <com.tracer.fleettracker.ui.SwipeSliderView
        android:id="@+id/swipeSliderShift"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="6dp" />

</LinearLayout>
