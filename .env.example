# ==============================================================================
# FLEET COMMAND CONFIGURATION (Cloud-Ready for Render, AWS, Heroku, Local)
# ==============================================================================

# Server Environment & Port
PORT=3000
NODE_ENV=development

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGIN=*

# PostgreSQL / PostGIS Connection
# For Cloud Deployments (Render, AWS RDS, Neon, Supabase), use DATABASE_URL:
# DATABASE_URL=postgres://user:password@cloud-host.com:5432/dbname
DATABASE_URL=

# Fallback discrete database parameters (used if DATABASE_URL is empty):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fleet_command
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT=5000
DB_IDLE_TIMEOUT=30000

# Primary Geofence Anchor (Default: GITAM Knowledge Resource Centre - KRC)
CAMPUS_CENTER_LAT=17.782167
CAMPUS_CENTER_LON=83.377472
CAMPUS_RADIUS_METERS=100.0
